<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>reconfox — {{ result.target.hostname }}</title>
<style>
  :root {
    --bg: #0f1117;
    --bg-card: #181b24;
    --bg-row: #1d2230;
    --fg: #e5e7eb;
    --fg-dim: #9ca3af;
    --accent: #fb923c;
    --border: #2a2f3e;
    --info: #6b7280;
    --low: #3b82f6;
    --medium: #eab308;
    --high: #f97316;
    --critical: #ef4444;
    --success: #22c55e;
    --partial: #eab308;
    --failed: #ef4444;
    --pending: #6b7280;
    --running: #3b82f6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg); color: var(--fg);
    font-size: 14px; line-height: 1.5;
  }
  h1, h2, h3 { margin: 0 0 16px; font-weight: 600; }
  h1 { font-size: 28px; color: var(--accent); }
  h2 { font-size: 20px; border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-top: 32px; }
  h3 { font-size: 16px; margin-top: 24px; }
  .container { max-width: 1100px; margin: 0 auto; }
  .meta { color: var(--fg-dim); margin-bottom: 24px; }
  .meta code { background: var(--bg-card); padding: 2px 6px; border-radius: 4px; }
  .card {
    background: var(--bg-card); padding: 20px; border-radius: 8px;
    border: 1px solid var(--border); margin-bottom: 20px;
  }
  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 12px;
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.5px; color: #fff;
  }
  .badge-status-completed { background: var(--success); }
  .badge-status-partial { background: var(--partial); color: #000; }
  .badge-status-failed { background: var(--failed); }
  .badge-status-pending { background: var(--pending); }
  .badge-status-running { background: var(--running); }
  .badge-sev-info { background: var(--info); }
  .badge-sev-low { background: var(--low); }
  .badge-sev-medium { background: var(--medium); color: #000; }
  .badge-sev-high { background: var(--high); }
  .badge-sev-critical { background: var(--critical); }
  table {
    width: 100%; border-collapse: collapse; margin-bottom: 16px;
    background: var(--bg-card); border-radius: 8px; overflow: hidden;
  }
  th, td {
    padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border);
  }
  th { background: var(--bg-row); font-weight: 600; color: var(--fg-dim); }
  tr:last-child td { border-bottom: none; }
  td code { background: var(--bg-row); padding: 1px 5px; border-radius: 3px; font-size: 12px; }
  .kv { display: grid; grid-template-columns: 140px 1fr; gap: 6px 16px; }
  .kv dt { color: var(--fg-dim); }
  .kv dd { margin: 0; }
  .errors li { color: var(--critical); font-family: monospace; font-size: 13px; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border);
           color: var(--fg-dim); font-size: 12px; }
  footer a { color: var(--accent); text-decoration: none; }
</style>
</head>
<body>
<div class="container">

<h1>reconfox <span class="badge badge-status-{{ result.status.value }}">{{ result.status.value }}</span></h1>

<div class="meta">
  <code>{{ result.target.url }}</code> &middot;
  mode: <code>{{ result.mode.value }}</code> &middot;
  started: {{ result.started_at.isoformat() }}
  {% if result.duration_seconds is not none %}
    &middot; duration: {{ "%.0f"|format(result.duration_seconds) }}s
  {% endif %}
</div>

<h2>Цель</h2>
<div class="card">
  <dl class="kv">
    <dt>Hostname</dt><dd><code>{{ result.target.hostname }}</code></dd>
    <dt>IP</dt><dd><code>{{ result.target.ip or "—" }}</code></dd>
    <dt>Port</dt><dd>{{ result.target.port }}</dd>
    <dt>HTTPS</dt><dd>{{ "да" if result.target.is_https else "нет" }}</dd>
    {% if result.target.asn %}
      <dt>ASN</dt><dd>AS{{ result.target.asn.asn }} {{ result.target.asn.asn_name or "" }}</dd>
      {% if result.target.asn.isp %}<dt>ISP</dt><dd>{{ result.target.asn.isp }}</dd>{% endif %}
    {% endif %}
    {% if result.target.geo %}
      {% set g = result.target.geo %}
      {% set loc = [g.city, g.region, g.country] | select | list | join(", ") %}
      {% if loc %}<dt>Локация</dt><dd>{{ loc }}</dd>{% endif %}
      {% if g.lat is not none %}<dt>Координаты</dt><dd>{{ g.lat }}, {{ g.lon }}</dd>{% endif %}
    {% endif %}
  </dl>
</div>

{% if result.ports %}
<h2>Открытые порты ({{ result.ports|length }})</h2>
<table>
  <thead><tr><th>Порт</th><th>Proto</th><th>State</th><th>Service</th><th>Product</th><th>Version</th></tr></thead>
  <tbody>
  {% for p in result.ports|sort(attribute='port') %}
    <tr>
      <td><code>{{ p.port }}</code></td>
      <td>{{ p.protocol }}</td>
      <td>{{ p.state }}</td>
      <td>{{ p.service or "—" }}</td>
      <td>{{ p.product or "—" }}</td>
      <td>{{ p.version or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if result.web_findings %}
<h2>Веб-находки ({{ result.web_findings|length }})</h2>
<table>
  <thead><tr><th>URL</th><th>Status</th><th>Length</th><th>Redirect</th></tr></thead>
  <tbody>
  {% for f in result.web_findings %}
    <tr>
      <td><code>{{ f.url }}</code></td>
      <td>{{ f.status }}</td>
      <td>{{ f.length }}</td>
      <td>{{ f.redirect or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if result.vulnerabilities %}
<h2>Уязвимости ({{ result.vulnerabilities|length }})</h2>
{% for v in result.vulnerabilities|sort(attribute='severity.score', reverse=true) %}
<div class="card">
  <h3>
    <span class="badge badge-sev-{{ v.severity.value }}">{{ v.severity.value }}</span>
    {{ v.title }}
    {% if v.cve %} <code>{{ v.cve }}</code>{% endif %}
  </h3>
  <dl class="kv">
    <dt>Источник</dt><dd>{{ v.source }}</dd>
    {% if v.affected_port %}<dt>Порт</dt><dd>{{ v.affected_port }} ({{ v.affected_service or "—" }})</dd>{% endif %}
    {% if v.description %}<dt>Описание</dt><dd>{{ v.description }}</dd>{% endif %}
    {% if v.metasploit_module %}<dt>Metasploit</dt><dd><code>{{ v.metasploit_module }}</code></dd>{% endif %}
    {% if v.exploit_path %}<dt>Exploit</dt><dd><code>{{ v.exploit_path }}</code></dd>{% endif %}
  </dl>
</div>
{% endfor %}
{% endif %}

{% if result.errors %}
<h2>Ошибки</h2>
<ul class="errors">
{% for e in result.errors %}
  <li>{{ e }}</li>
{% endfor %}
</ul>
{% endif %}

<footer>
  Generated by <a href="https://github.com/kovanZ1/reconfox">reconfox</a>
  {% if result.finished_at %} &middot; finished at {{ result.finished_at.isoformat() }}{% endif %}
</footer>

</div>
</body>
</html>
